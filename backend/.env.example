AISSTREAM_API_KEY=your_aisstream_api_key_here

# ==============================
# PostgreSQL (Supabase or Local)
# ==============================
DATABASE_URL=postgresql://postgres.your_project:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ==============================
# AIS Monitoring Region
# ==============================
AIS_MIN_LAT=04.00
AIS_MAX_LAT=24.00
AIS_MIN_LON=61.00
AIS_MAX_LON=92.00
AIS_CIRCLE_RADIUS_KM=50
AIS_POLL_SECONDS=300

# ==============================
# EcoNavigators API Settings
# ==============================
USE_MOCK_DATA=false
